        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FoodAppProject"
        tools:targetApi="31">

        <activity
            android:name=".login_activity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".admin_activity"
            android:exported="true" />

        <activity
            android:name=".home_activity"
            android:exported="true" />

        <activity
            android:name=".cart_activity"
            android:exported="true" />

        <activity
            android:name=".history_activity"
            android:exported="true" />

        <activity
            android:name=".add_food_activity"
            android:exported="true" />

        <activity
            android:name=".change_password_activity"
            android:exported="true" />

        <activity
            android:name=".profile_activity"
            android:exported="true" />

        <activity
            android:name=".edit_profile_activity"
            android:exported="true" />

    </application>

</manifest>
