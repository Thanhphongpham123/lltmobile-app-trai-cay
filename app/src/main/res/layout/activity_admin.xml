<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F8E9">

    <!-- Header Admin -->
    <LinearLayout
        android:id="@+id/adminHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛠️ QUẢN TRỊ ADMIN"
                android:textColor="#1B5E20"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAdminStoreSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quán Trái Cây Cắt Sẵn FreshCut • 🟢 Đang mở"
                android:textColor="#33691E"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSwitchToCustomer"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="#D32F2F"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="🚪 Đăng xuất"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="18dp" />
    </LinearLayout>

    <!-- 3 Thẻ Thống Kê (Doanh thu | Đơn hàng | Sản phẩm) -->
    <LinearLayout
        android:id="@+id/kpiContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/adminHeader">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1.25"
            android:background="@drawable/bg_card_white"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💰 Doanh thu"
                android:textColor="#33691E"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvAdminRevenue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:text="274.000đ"
                android:textColor="#E65100"
                android:textSize="15.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_white"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📦 Đơn hàng"
                android:textColor="#33691E"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvAdminOrdersCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="2 đơn"
                android:textColor="#1B5E20"
                android:textSize="15.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card_white"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍉 Sản phẩm"
                android:textColor="#33691E"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvAdminProductsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="9 món"
                android:textColor="#1B5E20"
                android:textSize="15.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3 Tab Chức năng Admin -->
    <LinearLayout
        android:id="@+id/adminTabBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/kpiContainer">

        <Button
            android:id="@+id/btnAdminTabOrders"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="#2E7D32"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:singleLine="true"
            android:text="📦 Đơn hàng"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="18dp" />

        <Button
            android:id="@+id/btnAdminTabProducts"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:backgroundTint="#C8E6C9"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:singleLine="true"
            android:text="🍉 Sản phẩm"
            android:textAllCaps="false"
            android:textColor="#1B5E20"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="18dp" />

        <Button
            android:id="@+id/btnAdminTabStore"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="#C8E6C9"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:singleLine="true"
            android:text="🏪 Cửa hàng"
            android:textAllCaps="false"
            android:textColor="#1B5E20"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="18dp" />
    </LinearLayout>

    <!-- Nội dung chính của Admin -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/adminTabBar">

        <LinearLayout
            android:id="@+id/llAdminContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
