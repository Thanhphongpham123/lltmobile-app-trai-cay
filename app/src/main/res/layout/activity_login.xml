<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F8E9">

    <TextView
        android:id="@+id/tvLogoEmoji"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:layout_marginTop="44dp"
        android:background="@drawable/radius"
        android:elevation="4dp"
        android:gravity="center"
        android:text="🍉"
        android:textSize="48sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="TRÁI CÂY CẮT SẴN"
        android:textColor="#1B5E20"
        android:textSize="27sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvLogoEmoji" />

    <TextView
        android:id="@+id/tvAppSlogan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Gọt sẵn tươi ngon • Tặng kèm muối chấm • Giao lạnh 30p"
        android:textColor="#33691E"
        android:textSize="13.5sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAppName" />

    <EditText
        android:id="@+id/edtLoginEmail"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="34dp"
        android:layout_marginEnd="28dp"
        android:background="@drawable/bg_brown_field"
        android:drawableEnd="@drawable/email"
        android:drawablePadding="12dp"
        android:drawableTint="#FFFFFF"
        android:hint="Email tài khoản"
        android:inputType="textEmailAddress"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:text="buu@foodapp.vn"
        android:textColor="#FFFFFF"
        android:textColorHint="#C8E6C9"
        android:textSize="17sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAppSlogan" />

    <EditText
        android:id="@+id/edtLoginPassword"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="28dp"
        android:background="@drawable/bg_brown_field"
        android:drawableEnd="@drawable/lock"
        android:drawablePadding="12dp"
        android:drawableTint="#FFFFFF"
        android:hint="Mật khẩu"
        android:inputType="textPassword"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:text="123456"
        android:textColor="#FFFFFF"
        android:textColorHint="#C8E6C9"
        android:textSize="17sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edtLoginEmail" />

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="26dp"
        android:layout_marginEnd="28dp"
        android:backgroundTint="#E65100"
        android:text="Đăng nhập"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="19sp"
        android:textStyle="bold"
        app:cornerRadius="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edtLoginPassword" />

    <Button
        android:id="@+id/btnRegisterDialog"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="28dp"
        android:backgroundTint="#2E7D32"
        android:text="Đăng ký tài khoản mua hàng"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16.5sp"
        android:textStyle="bold"
        app:cornerRadius="26dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnLogin" />

</androidx.constraintlayout.widget.ConstraintLayout>
