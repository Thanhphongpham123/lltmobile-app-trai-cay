<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F8E9"
    tools:context=".edit_profile_activity">

    <ImageButton
        android:id="@+id/BackToProfile"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Quay lại hồ sơ"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitleEditProfile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chỉnh sửa hồ sơ"
        android:textColor="#1B5E20"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/BackToProfile"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/BackToProfile" />

    <ImageView
        android:id="@+id/imgEditAvatar"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="20dp"
        android:importantForAccessibility="no"
        android:elevation="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/user"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/BackToProfile" />

    <TextView
        android:id="@+id/changeAvatar"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:gravity="center"
        android:focusable="true"
        android:text="Đổi ảnh đại diện"
        android:textColor="#1B5E20"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/imgEditAvatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <EditText style="@style/ShopProfileField"
        android:id="@+id/edtName"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:drawableEnd="@drawable/profile"
        android:gravity="start|center_vertical"
        android:hint="Họ và tên"
        android:inputType="textPersonName"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/changeAvatar" />

    <EditText style="@style/ShopProfileField"
        android:id="@+id/edtAddress"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="24dp"
        android:drawableEnd="@drawable/address"
        android:gravity="start|center_vertical"
        android:hint="Địa chỉ"
        android:inputType="textPostalAddress"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edtName" />

    <EditText style="@style/ShopProfileField"
        android:id="@+id/edtEmail"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="24dp"
        android:drawableEnd="@drawable/email"
        android:gravity="start|center_vertical"
        android:hint="Email liên hệ"
        android:inputType="textEmailAddress"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edtAddress" />

    <EditText style="@style/ShopProfileField"
        android:id="@+id/edtPhone"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="24dp"
        android:drawableEnd="@drawable/phone"
        android:gravity="start|center_vertical"
        android:hint="Số điện thoại"
        android:inputType="phone"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edtEmail" />

    <Button
        android:id="@+id/btnSaveProfile"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="48dp"
        android:backgroundTint="#E65100"
        android:drawableEnd="@android:drawable/ic_menu_save"
        android:drawableTint="#FFFFFF"
        android:drawablePadding="8dp"
        android:text="Lưu thông tin"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:cornerRadius="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edtPhone" />

</androidx.constraintlayout.widget.ConstraintLayout>
